# Copy to .env.local for local overrides (gitignored by Vite's default .gitignore).
#
# Base URL the RTK Query base query prefixes every request with. Leave empty
# for local dev: requests then go out as relative paths (e.g.
# "/api/v1/rooms/board"), same-origin against the Vite dev server, which
# proxies them to api-gateway server-side (see vite.config.ts) — no CORS
# involved, since api-gateway itself defines no CORS policy. Set this to the
# gateway's real public URL only for a non-local deployment.
VITE_API_BASE_URL=
