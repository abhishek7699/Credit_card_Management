# Local development environment variables for docker-compose.yml.
#
# Copy this file to `.env` (already gitignored — never commit it) before running
# `docker compose up` or `scripts/e2e-test.sh`:
#
#   cp .env.example .env
#
# These are NOT real production secrets. CockroachDB runs with `--insecure`
# (no authentication enforced at all) and Vault runs with `vault server -dev`
# (in-memory, single well-known root token chosen at boot). See SECURITY.md
# for why neither of these is safe outside local development/CI. Because
# neither backend actually validates these values, any non-empty string works
# for DB_USERNAME and VAULT_DEV_ROOT_TOKEN — the values below just match what
# this stack has always used, so copying this file as-is reproduces the exact
# same local behavior.

# CockroachDB connection, used by every service (insecure mode: not checked).
DB_USERNAME=root
DB_PASSWORD=

# Bootstraps Vault's dev-mode root token; transaction-service's Vault client
# must be given this same value to authenticate for card tokenization.
VAULT_DEV_ROOT_TOKEN=dev-root-token
